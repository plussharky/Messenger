{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5433;Database=messengerdb;Username=postgres;Password=postgres"
    },
    "Jwt": {
        "SecretKey": "your-super-secret-key-with-at-least-32-characters",
        "Issuer": "Messenger.Identity",
        "Audience": "Messenger",
        "AccessTokenExpirationMinutes": 60,
        "RefreshTokenExpirationDays": 30
    },
    "Jaeger": {
        "CollectorUrl": "http://localhost:4317",
        "AgentHost": "localhost",
        "AgentPort": 6831
    },
    "RabbitMQ": {
        "Host": "localhost",
        "Port": 5672,
        "Username": "guest",
        "Password": "guest",
        "VirtualHost": "/"
    }
}
