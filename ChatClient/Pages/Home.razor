@page "/"
@using ChatClient.Models
@using ChatClient.Services
@using MudBlazor
@inject AuthorizedHttpClient Http
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudStack>
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Чат</MudText>
            <MudButton OnClick="HandleLogout"
                       Color="Color.Secondary"
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Logout">
                Выйти
            </MudButton>
        </MudStack>

        <MudTextField @bind-Value="newMessage" Label="Введите сообщение" Variant="Variant.Filled" />
        <MudButton OnClick="SendMessage" Color="Color.Primary" Class="mt-2">Отправить</MudButton>

        <MudDivider Class="my-2" />

        <MudList T="ChatMessage" Dense="true">
            @foreach (var msg in messages)
            {
                <MudListItem T="ChatMessage" Value="msg">
                    @if (editMessageId == msg.Id)
                    {
                        <MudTextField @bind-Value="editMessageText" Variant="Variant.Filled" />
                        <MudButton OnClick="@(() => SaveEdit(msg.Id))" Color="Color.Success" Size="Size.Small">Сохранить</MudButton>
                        <MudButton OnClick="CancelEdit" Color="Color.Secondary" Size="Size.Small">Отмена</MudButton>
                    }
                    else
                    {
                        @msg.Text
                        <MudButton StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => StartEdit(msg))"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="ml-2">
                            Изменить
                        </MudButton>
                    }
                </MudListItem>
            }
        </MudList>
    </MudStack>
</MudContainer>

@code {
    private const string MessagesApiRoute = "api/Messages";

    private string newMessage = string.Empty;
    private List<ChatMessage> messages = new();

    private Guid? editMessageId = null;
    private string editMessageText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        
        if (isAuthenticated)
        {
            await LoadMessages();
        }
        else
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task LoadMessages()
    {
            messages = await Http.GetFromJsonAsync<List<ChatMessage>>(MessagesApiRoute) ?? new List<ChatMessage>();
    }

    private async Task SendMessage()
    {
        await UpsertMessageAsync(Guid.NewGuid(), newMessage);

        newMessage = string.Empty;
    }

    private async Task SaveEdit(Guid messageId)
    {
        await UpsertMessageAsync(messageId, editMessageText);

        editMessageId = null;
        editMessageText = string.Empty;
    }

    private async Task UpsertMessageAsync(Guid messageId, string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        var sendMessageRequest = new SendMessageRequest
        {
            Text = text
        };

        await Http.PutAsJsonAsync($"{MessagesApiRoute}/{messageId}", sendMessageRequest);

        await LoadMessages();
    }

    private void StartEdit(ChatMessage message)
    {
        editMessageId = message.Id;
        editMessageText = message.Text;
    }

    private void CancelEdit()
    {
        editMessageId = null;
        editMessageText = string.Empty;
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}
